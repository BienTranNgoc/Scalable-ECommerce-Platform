# ==============================================================================
#  ECOMMERCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
#  .env.example
#
#  HƯỚNG DẪN:
#  1. Copy file này: cp .env.example .env
#  2. Điền các giá trị thực vào file .env
#  3. KHÔNG BAO GIỜ commit file .env lên git (đã có trong .gitignore)
#
#  TẠI SAO DÙNG .env?
#  → 12-Factor App methodology: config phải tách biệt với code
#  → Mỗi môi trường (local/staging/prod) có config khác nhau
#  → Secrets không được hardcode trong source code
# ==============================================================================

# ==============================================================================
# POSTGRESQL
# ==============================================================================
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_strong_password_here

# Port exposed ra máy host (chỉ dùng local)
POSTGRES_PORT=5432

# ==============================================================================
# MONGODB
# ==============================================================================
MONGO_USER=ecommerce
MONGO_PASSWORD=change_me_strong_password_here
MONGO_PORT=27017

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_PASSWORD=change_me_strong_password_here
REDIS_PORT=6379

# ==============================================================================
# KAFKA
# ==============================================================================
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# ==============================================================================
# OPENSEARCH
# ==============================================================================
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# ==============================================================================
# KONG API GATEWAY
# ==============================================================================
KONG_PROXY_PORT=8000     # traffic vào đây, Kong route đến services
KONG_ADMIN_PORT=8001     # quản lý Kong qua REST API
KONG_GUI_PORT=8002       # Kong Manager (giao diện web)

# ==============================================================================
# CONSUL SERVICE DISCOVERY
# ==============================================================================
CONSUL_PORT=8500

# ==============================================================================
# PROMETHEUS & GRAFANA
# ==============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_strong_password_here
GRAFANA_SECRET_KEY=change_me_random_32_chars_here

# ==============================================================================
# LOGSTASH
# ==============================================================================
LOGSTASH_PORT=5044

# ==============================================================================
# DISTRIBUTED TRACING — Jaeger + OpenTelemetry
# ==============================================================================
JAEGER_UI_PORT=16686
ENVIRONMENT=local

# OTLP Endpoint — microservices dùng địa chỉ này để gửi traces
# Trong Docker network: http://otel-collector:4317 (gRPC) hoặc http://otel-collector:4318 (HTTP)
# Từ máy host (khi chạy service ngoài Docker): http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_VERSION=0.1.0

# ==============================================================================
# APPLICATION SECRETS — Điền vào khi code từng service
# ==============================================================================

# JWT Configuration (User Service)
JWT_SECRET_KEY=change_me_use_256_bit_random_string_minimum
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe (Payment Service) — dùng test key cho dev
STRIPE_API_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# SendGrid (Notification Service)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Twilio (Notification Service — SMS)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# EMAIL (Production Grafana alerts)
# ==============================================================================
SMTP_HOST=smtp.sendgrid.net:587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
